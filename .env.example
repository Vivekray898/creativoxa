RESEND_API_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
NEXT_PUBLIC_SUPABASE_URL=

# ── Advertising & consent ────────────────────────────────────────────────────
# AdSense publisher id, also written into public/ads.txt. Replace both together.
NEXT_PUBLIC_ADSENSE_CLIENT=

# Google-certified CMP id (AdSense → Privacy & messaging). While this is unset no
# CMP loads, every Consent Mode signal stays "denied", and no ad or analytics
# script is ever fetched. Set it before monetising.
NEXT_PUBLIC_CMP_ID=

# Ad unit ids per placement. An empty value renders nothing at that spot rather
# than an empty reserved box.
NEXT_PUBLIC_ADSLOT_INSIGHTS_INDEX=
NEXT_PUBLIC_ADSLOT_INSIGHTS_DETAIL=
NEXT_PUBLIC_ADSLOT_TOOLS_INDEX=
NEXT_PUBLIC_ADSLOT_TOOLS_DETAIL=